# OCS Console - BFF configuration
# Copy this file to .env and fill in your values

# ---- Database (OCS MariaDB/MySQL) ----
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=ocs
DB_PASS=changeme
DB_NAME=ocsweb

# ---- BFF ----
PORT=3000
CACHE_TTL=60

# ---- Authentication (OIDC / Microsoft Entra ID) ----
AUTH_ENABLED=true
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=changeme
BASE_URL=https://ocs-console.example.com
AUTHORIZED_GROUP_ID=00000000-0000-0000-0000-000000000000
SESSION_SECRET=changeme

# ---- Administrative fields (accountinfo) ----
# Field used as free-text description (editable in the asset detail page)
DESCRIPTION_FIELD=fields_16
# Field and pattern that determine if an asset is a "server" (for filters and stats)
SERVER_TYPE_FIELD=fields_6
SERVER_TYPE_PATTERN=serv|server
# Optional: path to a JSON file with admin field definitions [{key,label},...]
# If not set, fields are loaded from the OCS accountinfo_config table automatically
# ADMIN_FIELDS_FILE=/path/to/admin-fields.json
